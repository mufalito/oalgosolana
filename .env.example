# --- required ---
# Comma-separated API keys (each >= 16 chars). Bearer tokens for the REST API.
API_KEYS=change-me-please-32-chars-min
# Merchant wallet (base58). Funds go directly here; the API never moves them.
MERCHANT_WALLET=YourBase58MerchantWalletPubkeyHere1111
# Your own RPC endpoint (self-hosted node or paid provider). Never public mainnet RPC.
RPC_URL=https://api.devnet.solana.com
# HMAC secret for webhook signing (>= 32 bytes). Rotatable.
WEBHOOK_SECRET=change-me-at-least-32-bytes-long!!
# Postgres connection string.
DATABASE_URL=postgres://solanapay:solanapay@localhost:5432/solanapay?sslmode=disable

# --- optional (defaults shown) ---
PORT=8080
CLUSTER=devnet
USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Circle devnet USDC mint — operator must verify and set for devnet USDC.
USDC_MINT_DEVNET=
CONFIRMATION_POLICY=confirmed
EXPIRATION_MINUTES_DEFAULT=15
EXPIRATION_MINUTES_MIN=1
EXPIRATION_MINUTES_MAX=1440
WEBHOOK_MAX_ATTEMPTS=8
POLL_INTERVAL=5s
WORKER_COUNT=4
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# --- optional deposit-address mode (unique on-chain deposit vaults) ---
# When true, each invoice gets a unique on-chain deposit vault (see
# vault-program/); customers pay a plain address+amount from any wallet and
# the gateway sweeps to MERCHANT_WALLET on confirmation. SOL only. Default
# false (non-custodial Solana Pay reference mode).
DEPOSIT_ADDRESS_MODE=false
# base64 of 32 random bytes: openssl rand -base64 32
DEPOSIT_MASTER_KEY=
# Deployed vault program (see vault-program/; devnet prototype:
# HJfP8oj6MyigUYo3LHnk8JHRA11xMWDwQ1uxVoCuB1M4). Funds in deposit addresses
# can ONLY leave to MERCHANT_WALLET - a server compromise can delay sweeps
# but never redirect or steal.
DEPOSIT_PROGRAM_ID=
# JSON keypair paying vault rent + fees. It cannot redirect funds.
GATEWAY_HOT_WALLET=
