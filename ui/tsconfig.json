{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "types": [
      "$app/types",
      "node"
    ],
    "paths": {
      "#lib": [
        "./src/lib"
      ],
      "#lib/*": [
        "./src/lib/*"
      ]
    },
    "baseUrl": ".",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}